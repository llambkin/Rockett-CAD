{
  "name": "@rockett/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "vitest bench --run --reporter=default --reporter=json --outputFile.json=dist/bench.json",
    "build": "sh build.sh",
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/server.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@rockett/plugin-api": "0.1.0",
    "@rockett/shared": "0.1.0",
    "express": "5.2.1",
    "fflate": "0.8.3",
    "multer": "2.4.0",
    "opencascade.js": "https://github.com/msegec/opencascade.js/releases/download/v2.0.0-msegec.occt801.5/opencascade.js-2.0.0-msegec.occt801.5.tgz"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "24.13.6",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
