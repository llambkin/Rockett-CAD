{
  "name": "rockett-cad",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted, browser-based parametric CAD for 3D printing (B-Rep kernel, feature timeline)",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "build": "npm run build --workspace shared --if-present && npm run build --workspace server && npm run build --workspace client",
    "dev": "npm-run-all --parallel dev:server dev:client",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "lint:comments": "sh scripts/check-comments.sh",
    "lint:writing": "node ~/masterrulez/scripts/lint-writing",
    "prepare": "husky",
    "start": "npm run start --workspace server",
    "test": "npm run typecheck && vitest run",
    "test:client": "vitest run client/test",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p client"
  },
  "devDependencies": {
    "happy-dom": "20.14.5",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "npm-run-all2": "9.0.3",
    "oxlint": "1.79.0",
    "prettier": "3.9.6",
    "prettier-plugin-packagejson": "3.0.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24"
  }
}
