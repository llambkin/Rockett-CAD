const READER = `
import json, sys, importlib.metadata as md

def step(path):
    from OCP.STEPControl import STEPControl_Reader
    from OCP.IFSelect import IFSelect_RetDone
    from OCP.BRepCheck import BRepCheck_Analyzer
    from OCP.TopExp import TopExp_Explorer
    from OCP.TopAbs import TopAbs_SOLID
    from OCP.GProp import GProp_GProps
    from OCP.BRepGProp import BRepGProp
    reader = STEPControl_Reader()
    status = reader.ReadFile(path)
    if status != IFSelect_RetDone:
        return {"ok": False, "error": "ReadFile returned " + str(status)}
    roots = reader.NbRootsForTransfer()
    transferred = reader.TransferRoots()
    shape = reader.OneShape()
    solids = 0
    explorer = TopExp_Explorer(shape, TopAbs_SOLID)
    while explorer.More():
        solids += 1
        explorer.Next()
    props = GProp_GProps()
    BRepGProp.VolumeProperties_s(shape, props)
    valid = BRepCheck_Analyzer(shape).IsValid()
    return {
        "ok": valid and solids > 0 and transferred == roots,
        "entities": reader.WS().Model().NbEntities(),
        "roots": roots,
        "transferred": transferred,
        "solids": solids,
        "valid": valid,
        "volume": round(props.Mass(), 6),
    }

def threemf(path):
    import lib3mf
    model = lib3mf.get_wrapper().CreateModel()
    reader = model.QueryReader("3mf")
    reader.SetStrictModeActive(True)
    reader.ReadFromFile(path)
    warnings = [str(reader.GetWarning(i)) for i in range(reader.GetWarningCount())]
    objects = []
    meshes = model.GetMeshObjects()
    while meshes.MoveNext():
        mesh = meshes.GetCurrentMeshObject()
        objects.append({
            "name": mesh.GetName(),
            "vertices": mesh.GetVertexCount(),
            "triangles": mesh.GetTriangleCount(),
            "manifold": mesh.IsManifoldAndOriented(),
        })
    return {
        "ok": not warnings and bool(objects) and all(o["manifold"] for o in objects),
        "unit": lib3mf.ModelUnit(model.GetUnit()).name,
        "buildItems": model.GetBuildItems().Count(),
        "objects": objects,
        "warnings": warnings,
    }

def dxf(path):
    import collections, ezdxf
    doc = ezdxf.readfile(path)
    auditor = doc.audit()
    return {
        "ok": not auditor.has_errors,
        "dxfversion": doc.dxfversion,
        "insunits": doc.header.get("$INSUNITS"),
        "entities": dict(collections.Counter(e.dxftype() for e in doc.modelspace())),
        "layers": sorted(layer.dxf.name for layer in doc.layers),
        "errors": [e.message for e in auditor.errors],
        "fixes": len(auditor.fixes),
    }

fmt = sys.argv[1]
reader, package, read = {
    "step": ("OCP STEPControl_Reader", "cadquery-ocp-novtk", step),
    "3mf": ("lib3mf", "lib3mf", threemf),
    "dxf": ("ezdxf", "ezdxf", dxf),
}[fmt]
path = "/tmp/input." + fmt
with open(path, "wb") as f:
    f.write(sys.stdin.buffer.read())
try:
    result = read(path)
except Exception as e:
    result = {"ok": False, "error": type(e).__name__ + ": " + str(e)}
print(json.dumps({"format": fmt, "reader": reader, "version": md.version(package), **result}))
sys.exit(0 if result["ok"] else 1)
`;

function fail(message) {
  console.error(`interop-check: ${message}`);
  process.exit(2);
}

function engine() {
  for (const name of ["podman", "docker"])
    if (spawnSync(name, ["--version"], { stdio: "ignore" }).status === 0)
      return name;
  fail("podman or docker is required for step, 3mf and dxf");
}

function image(runtime) {
  const tag = `rockett-interop:${createHash("sha256").update(CONTAINERFILE).digest("hex").slice(0, 12)}`;
  if (
    spawnSync(runtime, ["image", "inspect", tag], { stdio: "ignore" })
      .status === 0
  )
    return tag;
  const context = mkdtempSync(join(tmpdir(), "rockett-interop-"));
  try {
    writeFileSync(join(context, "Containerfile"), CONTAINERFILE);
    const built = spawnSync(runtime, ["build", "-t", tag, context], {
      stdio: ["ignore", 2, 2],
    });
    if (built.status !== 0) fail(`image build failed with ${built.status}`);
  } finally {
    rmSync(context, { recursive: true });
  }
  return tag;
}

async function readGlb(bytes) {
  const validator = await import("gltf-validator");
  const report = await validator.validateBytes(new Uint8Array(bytes), {
    format: "glb",
    maxIssues: 50,
  });
  const { numErrors, numWarnings, numInfos, numHints, messages } =
    report.issues;
  const info = report.info ?? {};
  return {
    format: "glb",
    reader: "gltf-validator",
    version: report.validatorVersion,
    ok: numErrors === 0,
    generator: info.generator ?? null,
    materials: info.materialCount ?? 0,
    vertices: info.totalVertexCount ?? 0,
    triangles: info.totalTriangleCount ?? 0,
    errors: numErrors,
    warnings: numWarnings,
    infos: numInfos,
    hints: numHints,
    messages: messages.map(({ code, severity, pointer, message }) => ({
      code,
      severity,
      pointer: pointer ?? null,
      message,
    })),
  };
}

const [format, file] = process.argv.slice(2);
if (!FORMATS.includes(format) || !file)
  fail(`usage: scripts/interop-check <${FORMATS.join("|")}> <file>`);
const size = statSync(file, { throwIfNoEntry: false })?.size;
if (size === undefined) fail(`${file} does not exist`);
if (size > MAX_BYTES) fail(`${file} is over ${MAX_BYTES} bytes`);
const bytes = readFileSync(file);

if (format === "glb") {
  const result = await readGlb(bytes);
  console.log(JSON.stringify(result));
  process.exit(result.ok ? 0 : 1);
}

const runtime = engine();
const run = spawnSync(
  runtime,
  [
    "run",
    "--rm",
    "-i",
    "--network",
    "none",
    "--read-only",
    "--tmpfs",
    "/tmp",
    "--cap-drop",
    "all",
    "--security-opt",
    "no-new-privileges",
    "--user",
    "65534:65534",
    "--env",
    "HOME=/tmp",
    image(runtime),
    "python3",
    "-I",
    "-c",
    READER,
    format,
  ],
  {
    input: bytes,
    stdio: ["pipe", "inherit", "inherit"],
    timeout: 300_000,
    maxBuffer: 1 << 26,
  },
);
if (run.status === null)
  fail(`reader did not finish: ${run.error?.message ?? run.signal}`);
process.exit(run.status);
