#!/usr/bin/env node
import { spawnSync } from "node:child_process";
import { createHash } from "node:crypto";
import {
  mkdtempSync,
  readFileSync,
  rmSync,
  statSync,
  writeFileSync,
} from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";

const MAX_BYTES = 64 * 1024 * 1024;
const FORMATS = ["step", "3mf", "glb", "dxf"];

const CONTAINERFILE = `FROM docker.io/library/python@sha256:37134a49d21d2120e4c4d73bb76f8a4ab9aef31f096f7ec2ead48c2feead4332
RUN python3 - <<'PY'
import hashlib, subprocess, urllib.request
base = "https://snapshot.debian.org/archive/debian/20260922T000000Z/pool/main/"
debs = {
    "libg/libglvnd/libgl1_1.7.0-1+b2_amd64.deb": "87fa2f6e5abaed4ed385fac879c8dd735af719ee2300222d901793c66e041678",
    "libg/libglvnd/libglvnd0_1.7.0-1+b2_amd64.deb": "887f74008166549ce9e100c906aa937e95d6e5ce1c8d86efe8c95fd953359b9c",
    "libg/libglvnd/libglx0_1.7.0-1+b2_amd64.deb": "2721fdca0fe3bd963cb39482eabc253af52b88f4a7f6dbb69e475549daf5af3b",
    "libx/libx11/libx11-6_1.8.12-1_amd64.deb": "b5a3fd3bf8c8fd0364bfb9bea00dcba7fc301229bd02dded084632d31f5b0fb3",
    "libx/libxcb/libxcb1_1.17.0-2+b1_amd64.deb": "5c222a72d11b866447da31693254f738430726e3e065a384e82687b2fd2f978b",
    "libx/libxau/libxau6_1.0.11-1_amd64.deb": "689a9f0e0ba3e2c65431f864871e303ee904de69dd28abfc462663fae030227f",
    "libx/libxdmcp/libxdmcp6_1.1.5-1_amd64.deb": "0740dc760916b2008b45417a42a8fd7dd5de370fb57d31373f15034cda8acf0b",
    "e/expat/libexpat1_2.8.3-1~deb13u1_amd64.deb": "38abe0e710a07688e9c149d74536e67cfee0364bdb64dd6d644c32a1cfad389f",
}
for path, sha in debs.items():
    data = urllib.request.urlopen(base + path, timeout=120).read()
    if hashlib.sha256(data).hexdigest() != sha:
        raise SystemExit("hash mismatch: " + path)
    with open("/tmp/p.deb", "wb") as f:
        f.write(data)
    subprocess.run(["dpkg-deb", "-x", "/tmp/p.deb", "/"], check=True)
subprocess.run(["ldconfig"], check=True)
PY
RUN printf '%s\\n' \\
  'cadquery-ocp-novtk==8.0.1.0.0 --hash=sha256:1702dfc8f5bdcb916ce65ea0c6314fe453cc78a6a3d49a044fb3062d47b0ef9f' \\
  'cadquery-ocp-proxy==8.0.1.0.0 --hash=sha256:d6a6909a73d2300ca4581ff762ccf0137993ac75c57a2dc82e12bffa3a12b680' \\
  'lib3mf==2.5.0 --hash=sha256:b4c00033c47cfeac93b7daa069fb46e8dea4391d5522b79cd6e9f6af75e33013' \\
