(kicad_pcb
  (version 20241229)
  (general (thickness 1.6))
  (gr_rect (start 0 0) (end 100 100) (layer "Edge.Cuts"))
  (via (at bad bad) (drill bad))
  (footprint "Fixture:Front"
    (layer "F.Cu") (at 20 30 180)
    (uuid "00000000-0000-4000-8000-000000000001")
    (property "Reference" "J1") (property "Value" "Connector")
    (attr through_hole dnp exclude_from_bom future_attribute)
    (fp_rect (start -1 -2) (end 6 4) (layer "F.CrtYd"))
    (fp_rect (start -90 -90) (end 90 90) (layer "B.CrtYd"))
    (pad "1" thru_hole oval (at 2 3 15) (drill oval 1 2 (offset 0.4 -0.2)))
    (pad "2" np_thru_hole circle (at -2 1 -45) (drill 3.2))
    (pad "3" thru_hole circle (at 0 0) (drill oval 1.1))
    (pad "4" smd rect (at 4 0 7) (drill (offset 0.3 0.1)))
    (model "${KIPRJMOD}/models/fixture.step"
      (offset (xyz 1 -2 0.25)) (scale (xyz 1 2 -1)) (rotate (xyz 10 20 30)))
    (model "${KICAD9_3DMODEL_DIR}/fixture.wrl")
  )
  (footprint "Fixture:Back"
    (layer "B.Cu") (at 50 60 90)
    (uuid "00000000-0000-4000-8000-000000000002")
    (property "Reference" "U1") (property "Value" "Back part")
    (attr smd)
    (fp_rect (start 0 1) (end 4 3) (layer "B.CrtYd"))
    (pad "1" smd rect (at 2 1 -30))
  )
  (footprint "Fixture:MissingCourtyard" (layer "F.Cu") (at 10 10))
)
