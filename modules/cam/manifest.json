{
  "manifestVersion": 1,
  "id": "rockett.cam",
  "name": "CAM",
  "version": "0.1.0",
  "apiRange": "^0.23",
  "licence": "UNLICENSED",
  "author": "Rockett CAD",
  "contributes": {
    "workbenches": ["rockett.cam.manufacture"],
    "settings": [
      "plugin.rockett.cam.defaultMachine",
      "plugin.rockett.cam.safeHeight",
      "plugin.rockett.cam.clearance",
      "plugin.rockett.cam.tolerance"
    ],
    "routes": ["rockett.cam.document"],
    "kernelJobs": [
      "rockett.cam.regions",
      "rockett.cam.generate",
      "rockett.cam.surfaceMesh",
      "rockett.cam.features"
    ],
    "postProcessors": [
      "rockett.cam.fluidnc",
      "rockett.cam.grbl",
      "rockett.cam.grblhal",
      "rockett.cam.linuxcnc",
      "rockett.cam.mach",
      "rockett.cam.marlin"
    ]
  }
}
