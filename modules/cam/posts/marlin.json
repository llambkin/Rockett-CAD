{
  "id": "marlin",
  "label": "Marlin",
  "extension": "gcode",
  "capabilities": { "arcs": "xy", "cycles": false, "toolChange": false },
  "words": [
    "G0",
    "G1",
    "G2",
    "G3",
    "G4",
    "G21",
    "G54",
    "G90",
    "M0",
    "M3",
    "M4",
    "M5",
    "M7",
    "M8",
    "M9"
  ],
  "formats": {
    "X": { "decimals": 4, "trim": true },
    "Y": { "decimals": 4, "trim": true },
    "Z": { "decimals": 4, "trim": true },
    "I": { "decimals": 4, "trim": true },
    "J": { "decimals": 4, "trim": true },
    "F": { "decimals": 1, "trim": true },
    "S": { "decimals": 3, "trim": true }
  },
  "modal": [["M7", "M8", "M9"], "X", "Y", "Z", "F"],
  "workOffsets": ["G54"],
  "templates": {
    "header": ["G90", "{units}", "{offset}"],
    "footer": ["M5", "M9"],
    "toolChange": [],
    "toolLength": [],
    "spindleCw": ["M3 S{rpm}"],
    "spindleCcw": ["M4 S{rpm}"],
    "spindleOff": ["M5"],
    "coolantFlood": ["M8"],
    "coolantMist": ["M7"],
    "coolantOff": ["M9"],
    "rapid": ["G0 X{x} Y{y} Z{z}"],
    "linear": ["G1 X{x} Y{y} Z{z} F{feed}"],
    "arcCw": ["G2 X{x} Y{y} Z{z} I{i} J{j} F{feed}"],
    "arcCcw": ["G3 X{x} Y{y} Z{z} I{i} J{j} F{feed}"],
    "drill": [],
    "drillDwell": [],
    "peck": [],
    "cycleEnd": [],
    "dwell": ["G4 S{seconds}"],
    "stop": ["M0"],
    "optionalStop": ["M0"],
    "comment": "; {text}"
  }
}
